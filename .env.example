# Copy to .env (never commit .env)
POSTGRES_USER=chaintrack
# Dev default. `make prod` refuses to start unless this is set; use a real secret there.
POSTGRES_PASSWORD=chaintrack
POSTGRES_DB=chaintrack

# API. `make dev` has defaults for all of these; `make prod` requires them.
# Organisations are served at <slug>.BASE_DOMAIN
BASE_DOMAIN=localhost
# At least 32 random characters, e.g. `openssl rand -hex 32`
JWT_SECRET=
# First platform admin, created at API start if none exists. Password: at least 12 characters.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Contracts (Polygon Amoy testnet)
AMOY_RPC_URL=
DEPLOYER_KEY=
