# Copy to .env and fill in. Never commit .env. Details: docs/operations.md

# Postgres and Redis
# database user, password and name
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# host ports, e.g. 5478 and 6578
POSTGRES_PORT=
REDIS_PORT=

# API
# API port, e.g. 8080
PORT=
# json or text
LOG_FORMAT=
# debug, info, warn or error
LOG_LEVEL=
# true or false; empty: on in prod, off in dev
RATE_LIMIT=
# dev or prod
APP_ENV=
# web app address, no path, e.g. http://localhost:3000 or https://example.com
APP_URL=
# e.g. postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable
DATABASE_URL=
# e.g. redis://localhost:${REDIS_PORT}/0
REDIS_URL=

# Storage (any S3-compatible bucket)
# dev bucket port, e.g. 9478
STORAGE_PORT=
# e.g. http://localhost:${STORAGE_PORT}
STORAGE_ENDPOINT=
# e.g. us-east-1, or auto for R2
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Auth
# signs sign-in tokens: openssl rand -hex 32
JWT_SECRET=
# sign-in lifetime in minutes, e.g. 3600; with "keep me signed in", e.g. 43200
JWT_TTL=
JWT_TTL_REMEMBER=
# seals 2FA secrets and signing keys: openssl rand -hex 32
ENCRYPTION_KEY=
# first platform admin; prod password 12 to 72 characters
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Web app
# where the web server reaches the API, e.g. http://localhost:${PORT}
API_URL=
# prod: port the web app listens on (127.0.0.1 only), e.g. 3000
WEB_PORT=

# Chain
# RPC URL and chain id, e.g. http://127.0.0.1:8545 and 31337 for the local chain
CHAIN_RPC_URL=
CHAIN_ID=
# two different private keys: admin (make deploy only) and relayer (sends every transaction)
CHAIN_ADMIN_KEY=
CHAIN_RELAYER_KEY=
# printed by make deploy
ORG_REGISTRY_ADDRESS=
FACILITY_REGISTRY_ADDRESS=
PASSPORT_REGISTRY_ADDRESS=
CUSTODY_MANAGER_ADDRESS=
ATTESTATION_REGISTRY_ADDRESS=

# IPFS
# Pinata JWT, or none
PINATA_JWT=

# Email
# SMTP host, or none for in-app only, e.g. smtp.gmail.com
SMTP_HOST=
# e.g. 587
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# true or false; prod: true
SMTP_USE_TLS=
# sender, e.g. "ChainTrack <noreply@example.com>"
MAIL_FROM=
