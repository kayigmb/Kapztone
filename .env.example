# Copy to .env and fill in every value (never commit .env).
# Nothing has a default: a missing or invalid value stops `make` and the API,
# with a message naming it.

# --- Postgres and Redis containers (`make infra`) ---
POSTGRES_USER=chaintrack
POSTGRES_PASSWORD=
POSTGRES_DB=chaintrack
# Ports on your machine. Inside the Docker network they are always 5432 and 6379.
POSTGRES_PORT=5478
REDIS_PORT=6578

# --- API (`make api` runs it on your machine with these) ---
PORT=8080
# Logs: json (default, for production) or text (easier to read in a terminal); level debug | info | warn | error.
LOG_FORMAT=text
LOG_LEVEL=info
# dev or prod. dev also accepts ?pslug=<organisation> to choose the acting organisation.
APP_ENV=dev
# The web app's bare address (no path). E-mailed links (reset, verify, invite) start with it;
# an organisation's links put its slug in front of the host (acme.localhost:3000).
APP_URL=http://localhost:3000
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable
REDIS_URL=redis://localhost:${REDIS_PORT}/0
# Uploaded files (KYB documents, certificates) live in a private S3-compatible bucket.
# Development: RustFS from `make infra`, with the values below as given (pick any keys;
# RustFS starts with them). The API creates the bucket in dev. `make storage-reset` wipes it.
# Production: no RustFS. Create a private bucket first, then either
#   AWS S3:  STORAGE_ENDPOINT=https://s3.amazonaws.com, STORAGE_REGION=<bucket's region>,
#            keys of an IAM user allowed s3:GetObject, s3:PutObject, s3:DeleteObject on it
#   GCS:     STORAGE_ENDPOINT=https://storage.googleapis.com, STORAGE_REGION=auto,
#            an HMAC key of a service account with Storage Object Admin on it
# STORAGE_PORT is RustFS's port on this machine; production ignores it but needs a value.
STORAGE_PORT=9478
STORAGE_ENDPOINT=http://localhost:${STORAGE_PORT}
STORAGE_REGION=us-east-1
STORAGE_BUCKET=chaintrack
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Signs sign-in tokens. Dev: any value. Prod: at least 32 characters (`openssl rand -hex 32`). Changing it signs everyone out.
JWT_SECRET=
# How long a sign-in lasts, in whole minutes (90 = 90 minutes).
JWT_TTL=3600
# How long a sign-in lasts with "Keep me signed in" ticked, in whole minutes (43200 = 30 days).
JWT_TTL_REMEMBER=43200
# Seals 2FA secrets (and later signing keys) in the database. Exactly 64 hex
# characters: `openssl rand -hex 32`. Changing it makes stored secrets unreadable.
ENCRYPTION_KEY=
# First platform admin, created at API start if none exists. Password: any length up to 72 in dev; 12 to 72 in prod.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# --- Web app (`make web` runs it on your machine with this) ---
# Where the Next.js server reaches the API. In containers compose sets it to the api service.
API_URL=http://localhost:${PORT}

# --- Chain (`make chain`, `make deploy`, `make relayer`) ---
# For a local chain use these two as given. For Polygon Amoy: its RPC URL and 80002.
CHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Two keys. The values here are Hardhat's public test accounts #0 and #1:
# local chain only, never fund them elsewhere. Outside a local chain they must
# differ, and the admin key stays offline after `make deploy`.
# CHAIN_ADMIN_KEY: used only by `make deploy` (deploys, wires the contracts,
# grants roles). The API and the relayer never read it.
CHAIN_ADMIN_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# CHAIN_RELAYER_KEY: sends every transaction (relayer + operator roles on-chain).
CHAIN_RELAYER_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
# Printed by `make deploy`; paste the five lines here.
ORG_REGISTRY_ADDRESS=
FACILITY_REGISTRY_ADDRESS=
PASSPORT_REGISTRY_ADDRESS=
CUSTODY_MANAGER_ADDRESS=
ATTESTATION_REGISTRY_ADDRESS=

# --- Outside services. Both are required; `none` says the service is not used. ---
# Pinata token: copies each certificate file to IPFS as well as storing it here.
# WARNING: a pinned file is public. Anyone holding its content id can read it,
# and it cannot be taken back. Leave this `none` unless certificates may be public.
PINATA_JWT=none
# ── Email (SMTP) ─────────────────────────────────────────────────────────────
# SMTP_HOST=none: notifications are shown in the app only, and the mail settings below can stay empty.
# SMTP_USER is only the login. Everyone sees MAIL_FROM as the sender, e.g. ChainTrack <noreply@chaintrack.digital>.
# Gmail: smtp.gmail.com, port 587, your address as SMTP_USER, an app password
# (myaccount.google.com/apppasswords) as SMTP_PASSWORD. Gmail shows your account address unless you add the
# MAIL_FROM address under "Send mail as". A custom domain needs SPF (and ideally DKIM) or the mail lands in spam.
# A value with spaces must be in quotes: SMTP_PASSWORD="abcd efgh ijkl mnop".
# SMTP_USE_TLS=true refuses a server that offers no encryption. Dev: optional (empty = false; STARTTLS
# is still used when the server offers it). Prod: must be true.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM="ChainTrack <noreply@chaintrack.digital>"
# Absolute https URL of the ChainTrack mark shown atop HTML mail (put the file
# from frontend/public/brand/ on a public host, e.g. https://app.example.com/brand/chaintrack-mark.svg).
# Empty means the header shows the name as text.
MAIL_LOGO_URL=
