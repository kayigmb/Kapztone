# Copy to .env and fill in every value (never commit .env).
# Nothing has a default: a missing or invalid value stops `make` and the API,
# with a message naming it.

# --- Postgres and Redis containers (`make infra`) ---
POSTGRES_USER=chaintrack
POSTGRES_PASSWORD=
POSTGRES_DB=chaintrack
# Ports on your machine. Inside the Docker network they are always 5432 and 6379.
POSTGRES_PORT=5478
REDIS_PORT=6578

# --- API (`make api` runs it on your machine with these) ---
PORT=8080
# dev or prod. dev also accepts ?pslug=<organisation> to choose the acting organisation.
APP_ENV=dev
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable
REDIS_URL=redis://localhost:${REDIS_PORT}/0
# Where uploaded KYB documents are stored, relative to backend/.
UPLOAD_DIR=uploads
# Signs sign-in tokens. At least 32 characters: `openssl rand -hex 32`. Changing it signs everyone out.
JWT_SECRET=
# How long a sign-in lasts, in whole minutes (90 = 90 minutes).
JWT_TTL=3600
# Seals 2FA secrets (and later signing keys) in the database. Exactly 64 hex
# characters: `openssl rand -hex 32`. Changing it makes stored secrets unreadable.
ENCRYPTION_KEY=
# First platform admin, created at API start if none exists. Password: 12 to 72 characters.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# --- Web app (`make web` runs it on your machine with this) ---
# Where the Next.js server reaches the API. In containers compose sets it to the api service.
API_URL=http://localhost:${PORT}

# --- Chain (`make chain`, `make deploy`, `make relayer`) ---
# For a local chain use these two as given. For Polygon Amoy: its RPC URL and 80002.
CHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Sends every transaction and holds the admin and relayer roles. This value is
# Hardhat's public test account #0: local chain only, never fund it elsewhere.
CHAIN_PLATFORM_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Printed by `make deploy`; paste the five lines here.
ORG_REGISTRY_ADDRESS=
FACILITY_REGISTRY_ADDRESS=
PASSPORT_REGISTRY_ADDRESS=
CUSTODY_MANAGER_ADDRESS=
ATTESTATION_REGISTRY_ADDRESS=

# --- Outside services. Both are required; `none` says the service is not used. ---
# Pinata token: copies each certificate file to IPFS as well as storing it here.
# WARNING: a pinned file is public. Anyone holding its content id can read it,
# and it cannot be taken back. Leave this `none` unless certificates may be public.
PINATA_JWT=none
# Mail server for notification e-mail: smtp://user:password@host:port?from=no-reply@example.com
# With `none`, notifications are shown in the app only.
SMTP_URL=none
